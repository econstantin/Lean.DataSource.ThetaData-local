<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>QuantConnect.Lean.DataSource.ThetaData.DataWriter</AssemblyName>
		<RootNamespace>QuantConnect.Lean.DataSource.ThetaData.DataWriter</RootNamespace>
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\QuantConnect.ThetaData\QuantConnect.DataSource.ThetaData.csproj" />
	</ItemGroup>
</Project>
